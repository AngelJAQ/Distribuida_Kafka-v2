# Copia este archivo como 'equipo.env' en CADA equipo y ajústalo.
#
# NODE_ID = orden de PRIORIDAD de relevo (broker y router):
#   1 = principal, 2 = primer relevo, 3 = segundo relevo
# MI_IP   = IP de ESTE equipo en la red (la que ven los otros equipos)
# IP_PCx  = IP de los 3 equipos (igual en los 3 archivos)
NODE_ID=1
MI_IP=192.168.1.101

IP_PC1=192.168.1.101
IP_PC2=192.168.1.102
IP_PC3=192.168.1.103

# Roles que atiende el nodo de cálculo de este equipo (separados por espacio).
# Opciones: suma resta multiplicacion division potencia modulo raiz   |   todos
NODO_ROLES=todos
